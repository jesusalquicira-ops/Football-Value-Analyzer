# ============================================================
#  FOOTBALL VALUE ANALYZER — Configuración de API Keys
#  Copia este archivo como .env y rellena tus keys
# ============================================================

# 1. THE ODDS API — fixtures próximos + cuotas en tiempo real
#    Registro GRATIS: https://the-odds-api.com/
#    Plan gratuito: 500 llamadas/mes
ODDS_API_KEY=TU_API_KEY_AQUI

# 2. FOOTBALL-DATA.ORG — estadísticas de equipos (temporada actual)
#    Registro GRATIS: https://www.football-data.org/client/register
#    Plan gratuito: 10 llamadas/minuto, temporada actual incluida
FOOTBALL_DATA_KEY=TU_API_KEY_AQUI
